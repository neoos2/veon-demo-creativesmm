---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import FutureLink from "../components/FutureLink.astro";
import CallLink from "../components/CallLink.astro";
import Plate from "../components/Plate.astro";
import "../styles/site.css";
import { phone, hours, mapUrl, legalName, futureNote, socials, nav, courses } from "../data/site";

const title = "Курси SMM у Львові та онлайн, SMM і SEO для бізнесу — Creative SMM";
const description = "Курс «SMM на 100%»: 19 занять, 46 годин, Львів або онлайн. Курси Fb Ads, Google Ads, YouTube. SMM-просування і SEO для бізнесу. Телефонуйте: 097 164 05 00.";

const sameAs = [socials.instagram.href, socials.facebook.href, socials.tiktok.href, socials.youtube.href];
const courseLd = (name: string, desc: string, price?: string) => ({
  "@type": "Course",
  name,
  description: desc,
  inLanguage: "uk",
  provider: { "@id": "#org" },
  ...(price ? { offers: { "@type": "Offer", price, priceCurrency: "UAH", category: "Paid" } } : {}),
});
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["EducationalOrganization", "LocalBusiness"],
      "@id": "#org",
      name: "Creative SMM",
      legalName,
      telephone: "+380971640500",
      address: { "@type": "PostalAddress", streetAddress: "вул. Кульпарківська, 200А", addressLocality: "Львів", postalCode: "79021", addressCountry: "UA" },
      openingHoursSpecification: { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "10:00", closes: "18:00" },
      founder: { "@id": "#marta" },
      sameAs,
    },
    { "@type": "Person", "@id": "#marta", name: "Марта Пастернак", jobTitle: "Засновниця, викладачка SEO & SMM", worksFor: { "@id": "#org" } },
    courseLd("SMM на 100%", "Груповий практичний курс SMM: 19 занять, 46 годин, двічі на тиждень, Львів або онлайн.", "20000"),
    courseLd("Експрес-курс «SMM на 100%»", "6 занять, 15 годин.", "3500"),
    courseLd("Fb Ads на 100%", "Індивідуально, Львів або онлайн: 3 або 5 занять, 12 годин.", "8500"),
    courseLd("Google Ads на 100%", "Львів або онлайн: 5 занять по 2 години.", "12500"),
    courseLd("YouTube на 100%", "Індивідуально: 3 заняття по 3 години.", "8500"),
    courseLd("SMM, як мистецтво!", "Оформлення Instagram, stories і TikTok з телефону: 8 занять, 20 годин.", "7000"),
  ],
};

const img = (name: string, widths: number[]) => widths.map((w) => `img/${name}-${w}.webp ${w}w`).join(", ");
---
<Base lang="uk" title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" href="fonts/FixelDisplay-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="data:," />
    <script type="application/ld+json" data-rec="SE-R002,S-R012" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <header class="site-header" slot="header" data-rec="UX-R001,UX-R002">
    <div class="container site-header__row">
      <a class="logo" href="#top" aria-label="Creative SMM — на початок сторінки">
        <img src="img/logo.png" width="198" height="34" alt="Creative SMM" />
      </a>
      <nav class="nav" aria-label="Основна навігація">
        <ul class="nav__list">
          {nav.map((n) => <li><a class="nav__link" href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="site-header__actions">
        <a class="header-phone" href={phone.href}>{phone.label}</a>
        <CallLink class="header-call" />
        <details class="menu">
          <summary class="icon-btn menu__toggle" aria-label="Меню">
            <span class="menu__bars" aria-hidden="true"></span>
          </summary>
          <div class="menu__panel">
            <ul>
              {nav.map((n) => <li><a class="menu__link" href={n.href}>{n.label}</a></li>)}
            </ul>
            <p class="menu__phone"><a href={phone.href}>{phone.label}</a></p>
            <p class="menu__hours">{hours}</p>
          </div>
        </details>
      </div>
    </div>
  </header>

  <!-- 1 · top -->
  <Section id="top" rec="UX-R001,SE-R001" class="hero">
    <p class="hero__phone"><a href={phone.href}>{phone.label}</a> <span>{hours}</span></p>
    <div class="hero__frame">
      <picture class="hero__media">
        <source media="(max-width: 767px)" type="image/webp" srcset={img("hero-tall", [480, 800, 1024])} sizes="100vw" />
        <img src="img/hero-wide-1280.webp" srcset={img("hero-wide", [640, 1280, 1703])} sizes="100vw" width="1703" height="958" fetchpriority="high" decoding="async" alt="Марта Пастернак у червоному жакеті з телефоном у руці серед рослин" />
      </picture>
      <p class="hero__name lower-third"><Plate tone="pink"><b>Марта Пастернак</b> — засновниця, викладачка SEO&nbsp;&amp;&nbsp;SMM</Plate></p>
    </div>
    <div class="container hero__content">
      <h1 class="hero__title"><Plate>Вчимо SMM на&nbsp;100% <br />і просуваємо бізнес&nbsp;— <br />у Львові та онлайн</Plate></h1>
      <div class="hero__lead-wrap"><p class="hero__lead">Школа й агенція SMM, SEO та реклами з 2015 року: курси наживо у Львові та онлайн, просування для бізнесу.</p></div>
      <div class="hero__actions">
        <CallLink class="btn--lg" />
        <a class="btn btn--ghost hero__choose" href="#kursy">Обрати курс</a>
      </div>
    </div>
  </Section>

  <!-- 2 · zadachi -->
  <Section id="zadachi" rec="UX-R003" class="section zadachi">
    <div class="container">
      <h2 class="h2" data-reveal><span class="clip"><Plate>З чим ви прийшли?</Plate></span></h2>
      <ul class="forks">
        <li><a class="fork" href="#smm-na-100"><span class="fork__title">Навчитися професії</span><span class="fork__who">Для початківців: груповий курс «SMM на 100%»</span><span class="fork__arrow" aria-hidden="true">→</span></a></li>
        <li><a class="fork" href="#kursy"><span class="fork__title">Підсилити навички</span><span class="fork__who">Для практиків: Fb Ads, Google Ads, YouTube, візуал</span><span class="fork__arrow" aria-hidden="true">→</span></a></li>
        <li><a class="fork" href="#biznes"><span class="fork__title">Просування бізнесу</span><span class="fork__who">Для власників: ведення, аудит, наставництво</span><span class="fork__arrow" aria-hidden="true">→</span></a></li>
        <li><a class="fork" href="#komandam"><span class="fork__title">Навчити команду</span><span class="fork__who">Для компаній: корпоративні й виїзні тренінги</span><span class="fork__arrow" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </Section>

  <!-- 3 · smm-na-100 -->
  <Section id="smm-na-100" rec="UX-R004" class="section flagship">
    <div class="container flagship__grid">
      <figure class="flagship__media">
        <img src="img/smm100-560.webp" srcset={img("smm100", [400, 560, 800])} sizes="(min-width: 1024px) 34vw, 100vw" width="560" height="560" loading="lazy" decoding="async" alt="Рука тримає напис «#SMMна100%»" />
      </figure>
      <div class="flagship__body">
        <p class="kicker">Флагманський курс</p>
        <h2 class="h2" data-reveal><span class="clip"><Plate>SMM на 100%</Plate></span></h2>
        <p class="lead">Груповий практичний курс для тих, хто хоче професію SMM-спеціаліста.</p>
        <p class="flagship__params">19 занять · 46 годин · двічі на тиждень · Львів, вул. Кульпарківська, 200А, або онлайн</p>
        <div class="flagship__price">
          <p class="price-big"><Plate tone="pink">20 000 грн</Plate> <span class="price-big__note">до старту</span></p>
          <p class="price-after">21 000 грн після старту</p>
        </div>
        <p class="flagship__date">Дату наступного набору уточнюйте за телефоном.</p>
        <div class="actions">
          <CallLink context="щодо курсу «SMM на 100%»" />
          <FutureLink note={futureNote} class="fl-btn">Програма курсу</FutureLink>
        </div>
      </div>
    </div>
  </Section>

  <!-- 4 · kursy -->
  <Section id="kursy" rec="UX-R004,SE-R003" class="section kursy">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal><span class="clip"><Plate>Інші курси</Plate></span></h2>
        <p class="section-head__text">Назва, формат, тривалість і ціна — в одному рядку. Дати наборів уточнюйте за телефоном.</p>
      </div>
      <ol class="program">
        {courses.map((c) => (
          <li class="course">
            <div class="course__main">
              <h3 class="course__name">{c.name}</h3>
              {c.note && <p class="course__note">{c.note}</p>}
              <p class="course__meta"><span>{c.format}</span>{c.duration && <span>{c.duration}</span>}</p>
            </div>
            <div class="course__price">
              {c.price ? <Plate tone="pink">{c.price}</Plate> : <span class="course__ask">Ціну уточнюйте за телефоном</span>}
              {c.priceAfter && <span class="course__after">{c.priceAfter}</span>}
            </div>
            <div class="course__actions">
              <FutureLink note={futureNote} class="fl-text">Детальніше</FutureLink>
              <a class="course__call" href={phone.href}>Зателефонувати<span class="visually-hidden"> щодо курсу {c.name}</span></a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- 5 · praktyka -->
  <Section id="praktyka" class="section praktyka">
    <figure class="praktyka__media">
      <picture>
        <source media="(max-width: 767px)" type="image/webp" srcset={img("praktyka-tall", [480, 800, 1300])} sizes="100vw" />
        <img src="img/praktyka-wide-1280.webp" srcset={img("praktyka-wide", [640, 1280, 1703])} sizes="100vw" width="1703" height="730" loading="lazy" decoding="async" alt="Марта Пастернак гортає YouTube-канал Creative SMM на телефоні поруч із ноутбуком" />
      </picture>
      <p class="praktyka__badge lower-third" data-reveal><Plate tone="pink">90–100% практики</Plate></p>
    </figure>
    <div class="container praktyka__grid">
      <div>
        <h2 class="h2" data-reveal><span class="clip"><Plate>Як ми навчаємо</Plate></span></h2>
        <p class="lead">На заняттях — 90–100% практики: студенти працюють із реальними проєктами, а після курсу ми допомагаємо з працевлаштуванням.</p>
        <ul class="formats">
          <li><b>Офлайн</b> у Львові</li>
          <li><b>Онлайн</b> наживо</li>
          <li><b>Відеокурс</b> у записі</li>
          <li><b>Корпоративно</b> з виїздом</li>
        </ul>
      </div>
      <div class="works">
        <h3 class="works__title">Роботи студентів і команди</h3>
        <ul class="works__list">
          <li><b>Карпати Travel в Яремче</b><span>Туризм · SMM, розробка сайту</span></li>
          <li><b>Магазин амулетів Анни Ефремової</b><span>Інтернет-магазин · SMM, розробка сайту</span></li>
          <li><b>QUANTUM</b><span>Продаж квартир у новобудовах · SMM, розробка сайту</span></li>
        </ul>
        <FutureLink note={futureNote} class="fl-text">Усе портфоліо</FutureLink>
      </div>
    </div>
  </Section>

  <!-- 6 · biznes -->
  <Section id="biznes" class="section biznes">
    <div class="container">
      <div class="section-head">
        <h2 class="h2" data-reveal><span class="clip"><Plate tone="white">Просування для бізнесу</Plate></span></h2>
        <p class="section-head__text">Агенція Creative SMM: SMM-просування, SEO, Google Ads, YouTube, сайти й аудити.</p>
      </div>
      <ul class="services">
        <li class="service"><div><h3 class="service__name">Ведення «SMM у дії»</h3><p class="service__desc">5–6 публікацій на тиждень, таргетована реклама, щомісячний звіт</p></div><p class="service__price">900 дол./міс</p></li>
        <li class="service"><div><h3 class="service__name">SMM-аудит бізнесу</h3><p class="service__desc">Аудит соцмереж вашого бізнесу</p></div><p class="service__price">2 500 грн</p></li>
        <li class="service"><div><h3 class="service__name">Наставництво з SMM</h3><p class="service__desc">Супровід від засновниці для бізнесу, особистих брендів і SMM-спеціалістів</p></div><p class="service__price">від 250 дол./міс</p></li>
        <li class="service"><div><h3 class="service__name">SEO-аудит і SEO-просування</h3><p class="service__desc">Аудит сайту і просування в пошуку</p></div><p class="service__ask">Ціну уточнюйте за телефоном</p></li>
        <li class="service"><div><h3 class="service__name">Розробка та підтримка сайтів</h3><p class="service__desc">Сайти для бізнесу і їх супровід</p></div><p class="service__ask">Ціну уточнюйте за телефоном</p></li>
      </ul>
      <div class="fit">
        <div class="fit__col">
          <h3 class="fit__title">З ким працюємо</h3>
          <ul><li>Локальний бізнес: кафе, ресторани, клініки</li><li>Експерти й особисті бренди</li><li>Інтернет-магазини</li><li>Сервісні компанії</li></ul>
        </div>
        <div class="fit__col">
          <h3 class="fit__title">Кого не беремо в просування</h3>
          <ul><li>Казино</li><li>Сірі ніші</li><li>Криптопроєкти</li><li>IT-компанії</li></ul>
          <p class="fit__note">Навчання відкрите для всіх ніш.</p>
        </div>
      </div>
      <div class="actions">
        <CallLink context="щодо просування бізнесу" />
        <a class="btn btn--light" href={socials.instagram.href} target="_blank" rel="noopener">Написати в Instagram</a>
      </div>
    </div>
  </Section>

  <!-- 7 · komandam -->
  <Section id="komandam" class="section komandam">
    <div class="container komandam__grid">
      <div>
        <h2 class="h2" data-reveal><span class="clip"><Plate>Навчимо вашу команду</Plate></span></h2>
        <p class="lead">Корпоративні тренінги з SMM і SEO з виїздом у ваш офіс.</p>
      </div>
      <div class="komandam__facts">
        <p class="cities">Львів, Хмельницький, Рівне, Яремче</p>
        <p class="terms"><span>від 4 годин</span> <Plate tone="pink">100 дол./год</Plate></p>
        <CallLink context="щодо корпоративного тренінгу" />
      </div>
    </div>
  </Section>

  <!-- 8 · pro-nas -->
  <Section id="pro-nas" class="section pro-nas">
    <div class="container">
      <h2 class="h2" data-reveal><span class="clip"><Plate>Хто навчає</Plate></span></h2>
      <div class="founder">
        <figure class="founder__media">
          <img src="img/marta-640.webp" srcset={img("marta", [400, 640])} sizes="(min-width: 1024px) 34vw, 100vw" width="640" height="800" loading="lazy" decoding="async" alt="Марта Пастернак сміється за ноутбуком зі стікером «#SMM богиня»" />
        </figure>
        <div class="founder__body">
          <h3 class="founder__name"><Plate tone="pink">Марта Пастернак</Plate></h3>
          <p class="founder__role">Засновниця Creative SMM, викладачка SEO &amp; SMM</p>
          <ul class="facts">
            <li><b>15+ років</b> у SEO і SMM</li>
            <li>Авторка книги <b>«SMM на 100%»</b></li>
            <li>Авторка <b>понад 10 курсів</b></li>
          </ul>
          <p class="team__intro">Команда</p>
          <ul class="team">
            <li><h3>Марія Кузьминих</h3><p>Web developer, SMM</p></li>
            <li><h3>Оксана Помірко</h3><p>Офіс-менеджер, SMM</p></li>
            <li><h3>Мар'яна Солодовченко</h3><p>Відео та фото</p></li>
            <li><h3>Юлія Деміків</h3><p>SMM-менеджер, реклама</p></li>
            <li><h3>Галина Музичка</h3><p>Маркетолог, PR</p></li>
          </ul>
        </div>
      </div>
      <div class="videos" data-rec="S-R014">
        <h3 class="videos__title"><Plate>Марта на YouTube</Plate></h3>
        <ul class="videos__list">
          <li class="video video--wide">
            <a href={socials.youtube.href} target="_blank" rel="noopener">
              <img src="img/yt-strategy-800.webp" srcset={img("yt-strategy", [480, 800])} sizes="(min-width: 1024px) 50vw, 100vw" width="800" height="450" loading="lazy" decoding="async" alt="" />
              <span class="video__name">Стратегія в SMM за 30 хв<span class="visually-hidden"> (відео на YouTube-каналі Creative SMM)</span></span>
            </a>
          </li>
          <li class="video">
            <a href={socials.youtube.href} target="_blank" rel="noopener">
              <img src="img/yt-burnout-404.webp" srcset={img("yt-burnout", [300, 404])} sizes="(min-width: 1024px) 20vw, 50vw" width="404" height="720" loading="lazy" decoding="async" alt="" />
              <span class="video__name">Чому SMM-ники вигоряють?<span class="visually-hidden"> (відео на YouTube-каналі Creative SMM)</span></span>
            </a>
          </li>
          <li class="video">
            <a href={socials.youtube.href} target="_blank" rel="noopener">
              <img src="img/yt-sales-404.webp" srcset={img("yt-sales", [300, 404])} sizes="(min-width: 1024px) 20vw, 50vw" width="404" height="720" loading="lazy" decoding="async" alt="" />
              <span class="video__name">SMM не продає! Чому?<span class="visually-hidden"> (відео на YouTube-каналі Creative SMM)</span></span>
            </a>
          </li>
        </ul>
        <p class="videos__more">
          <FutureLink note={futureNote} class="fl-text">Відгуки</FutureLink>
          <FutureLink note={futureNote} class="fl-text">Подкаст</FutureLink>
          <FutureLink note={futureNote} class="fl-text">Блог</FutureLink>
        </p>
      </div>
    </div>
  </Section>

  <!-- 9 · kontakty -->
  <Section id="kontakty" class="section kontakty">
    <div class="container">
      <h2 class="h2" data-reveal><span class="clip"><Plate>Контакти</Plate></span></h2>
      <p class="kontakty__lead">Зателефонуйте — підкажемо курс чи формат співпраці.</p>
      <a class="big-phone" href={phone.href}>{phone.label}</a>
      <dl class="kontakty__list">
        <div><dt>Години</dt><dd>{hours}</dd></div>
        <div><dt>Адреса</dt><dd>Львів, <a class="addr" href={mapUrl} target="_blank" rel="noopener">вул. Кульпарківська, 200А</a>, 79021</dd></div>
        <div><dt>Соцмережі</dt><dd class="socials">
          {[socials.instagram, socials.facebook, socials.tiktok, socials.youtube].map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </dd></div>
      </dl>
    </div>
  </Section>

  <footer class="site-footer" slot="footer" data-rec="UX-R002,S-R012">
    <div class="container site-footer__grid">
      <div>
        <a class="logo" href="#top" aria-label="Creative SMM — на початок сторінки"><img src="img/logo.png" width="198" height="34" alt="Creative SMM" loading="lazy" /></a>
        <p class="site-footer__legal">{legalName}</p>
      </div>
      <div>
        <p class="site-footer__title">Соцмережі</p>
        <ul class="site-footer__links">
          {Object.values(socials).map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="site-footer__title">Документи</p>
        <ul class="site-footer__links">
          <li><FutureLink note={futureNote} class="fl-text">Політика конфіденційності</FutureLink></li>
          <li><FutureLink note={futureNote} class="fl-text">Договір оферти</FutureLink></li>
        </ul>
      </div>
    </div>
  </footer>

  <nav class="call-bar" slot="footer" aria-label="Швидкий зв'язок" data-rec="UX-R002,S-R013">
    <a class="call-bar__call" href={phone.href}>Зателефонувати</a>
    <a class="call-bar__ig" href={socials.instagram.href} target="_blank" rel="noopener">Instagram</a>
  </nav>
  <script src="../scripts/header.ts"></script>
</Base>
